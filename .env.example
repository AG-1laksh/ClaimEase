# Copy this file to .env.local and fill in real values there.
# Never commit .env.local. Never put real values in this file.
#
# Names below are a team proposal; Member 2 (Supabase) and Member 3 (Gemini)
# should confirm or rename them before we rely on them.

# --- Browser-safe (NEXT_PUBLIC_ values are inlined into the client bundle at build time) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "true" shows clearly labeled example data instead of calling the backend.
NEXT_PUBLIC_USE_MOCKS=true

# --- Server-only (no NEXT_PUBLIC_ prefix; never import these in client components) ---
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
